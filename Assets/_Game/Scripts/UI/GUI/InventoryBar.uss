/* ── Inventory Bar ───────────────────────────────────────── */
.inventory-bar-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    flex-direction: row;
    justify-content: center;
}

.inventory-bar {
    flex-direction: row;
    padding: 4px;
    background-color: rgba(30, 30, 30, 0.92);
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    border-radius: 4px;
}

/* ── Slot ────────────────────────────────────────────────── */
.inventory-slot {
    width: 52px;
    height: 52px;
    margin: 2px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    border-radius: 3px;
    background-color: rgb(45, 45, 45);
    align-items: center;
    justify-content: center;
}

.inventory-slot--filled {
    border-color: rgb(110, 110, 110);
    background-color: rgb(55, 55, 55);
}

.inventory-slot-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Имя ресурса, если у него нет спрайта */
.inventory-slot-name {
    font-size: 9px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    white-space: normal;
}

.inventory-slot-index {
    position: absolute;
    top: 1px;
    left: 3px;
    font-size: 9px;
    color: rgb(120, 120, 120);
    padding: 0;
    margin: 0;
}

.inventory-slot-count {
    position: absolute;
    bottom: 1px;
    right: 3px;
    font-size: 11px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.inventory-slot-durability {
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 3px;
    height: 3px;
    border-radius: 1px;
    background-color: rgb(25, 25, 25);
}

.inventory-slot-durability-fill {
    height: 100%;
    border-radius: 1px;
}

/* ── Tooltip ─────────────────────────────────────────────── */
/* Подсказка над ячейкой: позицию (left/top) ставит InventoryBar, мышь проходит насквозь */
.inventory-tooltip {
    position: absolute;
    min-width: 120px;
    max-width: 260px;
    padding: 6px 8px;
    background-color: rgba(20, 20, 20, 0.96);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 4px;
}

.inventory-tooltip-title {
    font-size: 13px;
    color: rgb(240, 240, 240);
    -unity-font-style: bold;
    white-space: normal;
    padding: 0;
    margin: 0 0 3px 0;
}

.inventory-tooltip-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.inventory-tooltip-caption {
    font-size: 11px;
    color: rgb(160, 160, 160);
    padding: 0;
    margin: 0 4px 0 0;
}

/* Имя для кода: в проекте нет моноширинного шрифта — выделяем «фишкой» как код */
.inventory-tooltip-code {
    font-size: 11px;
    color: rgb(230, 200, 120);
    background-color: rgb(40, 40, 40);
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    border-radius: 2px;
    padding: 0 4px;
    margin: 0;
}

.inventory-tooltip-line {
    font-size: 11px;
    color: rgb(210, 210, 210);
    padding: 0;
    margin: 0;
}

.inventory-tooltip-food {
    font-size: 11px;
    color: rgb(140, 210, 120);
    padding: 0;
    margin: 0;
}

.inventory-tooltip-slot {
    font-size: 10px;
    color: rgb(130, 130, 130);
    padding: 0;
    margin: 3px 0 0 0;
}

.hidden {
    display: none;
}
