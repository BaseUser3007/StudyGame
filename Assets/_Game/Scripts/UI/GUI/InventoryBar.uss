/* ── Inventory Bar ───────────────────────────────────────── */
.inventory-bar-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    flex-direction: row;
    justify-content: center;
}

.inventory-bar {
    flex-direction: row;
    padding: 4px;
    background-color: rgba(30, 30, 30, 0.92);
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    border-radius: 4px;
}

/* ── Slot ────────────────────────────────────────────────── */
.inventory-slot {
    width: 52px;
    height: 52px;
    margin: 2px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    border-radius: 3px;
    background-color: rgb(45, 45, 45);
    align-items: center;
    justify-content: center;
}

.inventory-slot--filled {
    border-color: rgb(110, 110, 110);
    background-color: rgb(55, 55, 55);
}

.inventory-slot-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Имя ресурса, если у него нет спрайта */
.inventory-slot-name {
    font-size: 9px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    white-space: normal;
}

.inventory-slot-index {
    position: absolute;
    top: 1px;
    left: 3px;
    font-size: 9px;
    color: rgb(120, 120, 120);
    padding: 0;
    margin: 0;
}

.inventory-slot-count {
    position: absolute;
    bottom: 1px;
    right: 3px;
    font-size: 11px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.inventory-slot-durability {
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 3px;
    height: 3px;
    border-radius: 1px;
    background-color: rgb(25, 25, 25);
}

.inventory-slot-durability-fill {
    height: 100%;
    border-radius: 1px;
}

.hidden {
    display: none;
}
