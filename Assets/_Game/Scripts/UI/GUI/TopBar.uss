/* ── Top Bar ─────────────────────────────────────────────── */
.top-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 40px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(30, 30, 30);
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
    padding: 0 8px;
}

.top-bar-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
}

/* ── Sections ────────────────────────────────────────────── */
.top-bar-section {
    flex-direction: row;
    align-items: center;
}

.top-bar-center {
    flex-grow: 1;
    justify-content: center;
}

.top-bar-right {
    justify-content: flex-end;
}

/* ── Buttons ─────────────────────────────────────────────── */
.top-bar-btn {
    height: 28px;
    padding: 0 12px;
    margin: 0 2px;
    border-radius: 3px;
    border-width: 0;
    background-color: rgb(60, 60, 60);
    color: rgb(220, 220, 220);
    font-size: 12px;
}

.top-bar-btn:hover {
    background-color: rgb(80, 80, 80);
}

.btn-run {
    background-color: rgb(50, 100, 50);
    color: rgb(150, 220, 150);
}

.btn-run:hover {
    background-color: rgb(60, 130, 60);
}

.btn-run.btn-stop {
    background-color: rgb(110, 45, 45);
    color: rgb(230, 160, 160);
}

.btn-run.btn-stop:hover {
    background-color: rgb(140, 55, 55);
}

/* ── Day ─────────────────────────────────────────────────── */
.top-bar-left {
    min-width: 200px;
}

.day-label {
    font-size: 13px;
    color: rgb(150, 190, 240);
    -unity-font-style: bold;
}

.day-summary {
    font-size: 11px;
    margin-left: 10px;
    color: rgb(170, 170, 170);
}

.day-summary--penalty {
    color: rgb(240, 110, 110);
}

.day-summary--bonus {
    color: rgb(150, 220, 150);
}

/* ── Threat ──────────────────────────────────────────────── */
.threat-label {
    font-size: 12px;
    margin-left: 10px;
    padding: 1px 6px;
    border-radius: 3px;
    color: rgb(190, 170, 140);
}

/* Угроза завтра — предупреждение */
.threat-label--soon {
    color: rgb(240, 180, 90);
    -unity-font-style: bold;
}

/* Угроза идёт — красная плашка */
.threat-label--active {
    color: rgb(255, 235, 235);
    background-color: rgb(150, 40, 40);
    -unity-font-style: bold;
}

.btn-end-day {
    color: rgb(230, 200, 110);
}

.btn-exit-run {
    color: rgb(230, 160, 160);
}

/* ── Health ──────────────────────────────────────────────── */
.health {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.health-bar {
    width: 90px;
    height: 10px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    background-color: rgb(45, 30, 30);
    overflow: hidden;
    transition-property: border-color, background-color;
    transition-duration: 0.3s;
}

.health-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(200, 70, 70);
    transition-property: background-color;
    transition-duration: 0.3s;
}

/* Флэш при уроне: класс снимается из TopBar через HealthFlashMs */
.health--hit .health-bar {
    border-color: rgb(255, 200, 200);
    background-color: rgb(110, 40, 40);
    transition-duration: 0s;
}

.health--hit .health-fill {
    background-color: rgb(255, 170, 170);
    transition-duration: 0s;
}

.health-label {
    transition-property: color;
    transition-duration: 0.3s;
}

.health--hit .health-label {
    color: rgb(255, 220, 220);
    transition-duration: 0s;
}

.health-label {
    font-size: 13px;
    margin-left: 6px;
    color: rgb(240, 140, 140);
}

/* ── Energy ──────────────────────────────────────────────── */
.energy-label {
    font-size: 13px;
    color: rgb(150, 220, 150);
}

.program-cost {
    font-size: 13px;
    margin-left: 16px;
    color: rgb(230, 200, 110);
}

.program-cost--over {
    color: rgb(240, 110, 110);
    -unity-font-style: bold;
}

/* ── Help ────────────────────────────────────────────────── */
.btn-help {
    color: rgb(150, 190, 240);
}

.btn-achievements {
    color: rgb(230, 200, 110);
}

.btn-help--active {
    background-color: rgb(50, 70, 100);
}

.help-popup {
    position: absolute;
    top: 44px;
    right: 8px;
    width: 420px;
    max-height: 560px;
    background-color: rgba(30, 30, 30, 0.97);
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    border-radius: 4px;
    padding: 8px;
}

.help-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.help-title {
    font-size: 14px;
    color: rgb(150, 190, 240);
    -unity-font-style: bold;
}

.help-close {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgb(60, 60, 60);
    color: rgb(220, 220, 220);
    font-size: 14px;
}

.help-close:hover {
    background-color: rgb(80, 80, 80);
}

.help-content {
    flex-shrink: 1;
}

.help-section {
    font-size: 12px;
    color: rgb(230, 200, 110);
    -unity-font-style: bold;
    margin: 8px 0 4px 0;
}

.help-section-note {
    font-size: 11px;
    color: rgb(140, 140, 140);
    white-space: normal;
    margin: -2px 0 4px 0;
}

.help-entry {
    padding: 4px 6px;
    margin-bottom: 3px;
    border-radius: 3px;
    background-color: rgb(42, 42, 42);
}

.help-entry-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.help-signature {
    font-size: 12px;
    color: rgb(220, 220, 170);
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.help-cost {
    font-size: 11px;
    color: rgb(150, 220, 150);
    padding: 0;
    margin: 0 0 0 8px;
}

.help-description {
    font-size: 11px;
    color: rgb(190, 190, 190);
    white-space: normal;
    padding: 0;
    margin-top: 2px;
}

.help-keyword-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 1px 6px;
}

.help-keyword {
    font-size: 12px;
    color: rgb(200, 160, 230);
    padding: 0;
    margin: 0;
}

/* Закрытая конструкция языка: приглушённо, вместо цены — locked */
.help-keyword-row--locked .help-keyword {
    color: rgb(120, 110, 125);
}

.help-keyword-row--locked .help-cost {
    color: rgb(170, 100, 100);
    -unity-font-style: italic;
}

/* ── Utility ─────────────────────────────────────────────── */
.hidden {
    display: none;
}
/* Подсказки туториала выключены — кнопка приглушена */
.btn-hints--off {
    color: rgb(140, 140, 140);
}

/* ── Отладка: пауза на точке останова ────────────────────── */
.paused-label {
    color: rgb(120, 180, 240);
    -unity-font-style: bold;
    margin: 0 6px;
    -unity-text-align: middle-center;
}

.btn-debug {
    background-color: rgb(40, 70, 110);
    color: rgb(170, 205, 245);
}

.btn-debug:hover {
    background-color: rgb(50, 90, 140);
}
