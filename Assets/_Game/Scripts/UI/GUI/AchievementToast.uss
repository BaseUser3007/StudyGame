/* ── Layer ───────────────────────────────────────────────── */
/* Полоса под верхней панелью, тост — по центру */
.toast-layer {
    position: absolute;
    top: 52px;
    left: 0;
    right: 0;
    align-items: center;
}

/* ── Toast ───────────────────────────────────────────────── */
.achievement-toast {
    flex-direction: row;
    align-items: center;
    width: 400px;
    padding: 10px 12px;
    background-color: rgba(28, 36, 28, 0.97);
    border-width: 1px;
    border-color: rgb(110, 190, 110);
    border-radius: 6px;
    opacity: 0;
    translate: 0 -12px;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.3s;
}

.achievement-toast--visible {
    opacity: 1;
    translate: 0 0;
}

.toast-icon {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.toast-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.toast-caption {
    font-size: 11px;
    color: rgb(130, 210, 130);
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.toast-title {
    font-size: 15px;
    color: rgb(230, 230, 180);
    -unity-font-style: bold;
    padding: 0;
    margin: 1px 0 0 0;
}

.toast-description {
    font-size: 11px;
    color: rgb(200, 200, 200);
    white-space: normal;
    padding: 0;
    margin: 2px 0 0 0;
}

.toast-rewards {
    font-size: 11px;
    color: rgb(230, 200, 110);
    white-space: normal;
    padding: 0;
    margin: 3px 0 0 0;
}

.toast-more {
    font-size: 10px;
    color: rgb(140, 140, 140);
    padding: 0;
    margin: 3px 0 0 0;
}

/* ── Utility ─────────────────────────────────────────────── */
.hidden {
    display: none;
}
