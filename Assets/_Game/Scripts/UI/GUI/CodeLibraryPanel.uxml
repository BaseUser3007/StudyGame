<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="CodeLibraryPanel.uss"/>
    <ui:VisualElement name="library-root" class="library-root" picking-mode="Ignore">
        <ui:VisualElement name="library-drawer" class="library-drawer" picking-mode="Ignore">

            <!-- Ползунок посередине правого края -->
            <ui:Button name="btn-library-toggle" class="library-toggle" text="‹" tooltip="Code library: drag a window here to save it"/>

            <!-- Боковая панель -->
            <ui:VisualElement name="library-panel" class="library-panel hidden">
                <ui:VisualElement class="library-header">
                    <ui:Label class="library-title" text="Code library"/>
                    <ui:Button name="btn-close" class="library-close" text="×"/>
                </ui:VisualElement>

                <!-- Обмен кодом через буфер: Paste создаёт запись из буфера, статус — короткое сообщение -->
                <ui:VisualElement class="library-actions">
                    <ui:Button name="btn-paste" class="snippet-btn library-paste" text="Paste" tooltip="Create an entry from the clipboard"/>
                    <ui:Label name="library-status" class="library-status hidden"/>
                </ui:VisualElement>

                <ui:Label name="drop-hint" class="library-drop-hint" text="Drag a window here by its header to save its code"/>

                <!-- Показывается, пока окна-«классы» закрыты: записи нельзя открыть как окна -->
                <ui:Label name="locked-note" class="library-locked-note hidden" text="Class windows are not unlocked yet: entries are kept, but they can't be opened as windows for now"/>

                <!-- Сохранённые фрагменты: заполняется из кода -->
                <ui:ScrollView name="snippet-list" class="snippet-list"/>
                <ui:Label name="list-empty" class="library-empty" text="Nothing saved yet"/>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
