<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="HubPanel" src="HubPanel.uxml"/>
    <ui:Template name="AchievementsPanel" src="AchievementsPanel.uxml"/>
    <ui:Template name="UnlockPopup" src="UnlockPopup.uxml"/>
    <ui:Template name="AchievementToast" src="AchievementToast.uxml"/>
    <ui:Template name="TutorialOverlay" src="TutorialOverlay.uxml"/>
    <Style src="RunScreens.uss"/>
    <ui:VisualElement name="run-screens" class="run-screens" picking-mode="Ignore">

        <!-- Лагерь (хаб, этап 4): боковые панели поверх карты с сеткой; середина не ловит мышь (HubPanel.uxml) -->
        <ui:Instance template="HubPanel" name="hub-screen" class="screen-overlay hidden" picking-mode="Ignore"/>

        <!-- Подтверждение выхода из забега -->
        <ui:VisualElement name="exit-confirm" class="screen-backdrop hidden">
            <ui:VisualElement class="screen-card dialog-card">
                <ui:Label class="screen-title" text="Leave the run?"/>
                <ui:Label class="screen-text" text="Only materials are carried to the camp. Tools, buildings and food stay here."/>
                <ui:VisualElement class="screen-buttons">
                    <ui:Button name="btn-exit-cancel" class="screen-btn" text="Stay"/>
                    <ui:Button name="btn-exit-confirm" class="screen-btn screen-btn--danger" text="Leave"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Итоги забега (выход или поражение) -->
        <ui:VisualElement name="run-summary" class="screen-backdrop hidden">
            <ui:VisualElement class="screen-card summary-card">
                <ui:Label name="summary-title" class="screen-title" text="Run complete"/>
                <ui:Label name="summary-stats" class="screen-text" text=""/>
                <ui:Label class="screen-section" text="Carried to the camp"/>
                <ui:ScrollView name="summary-loot" class="item-list"/>
                <ui:Label name="summary-loot-empty" class="screen-empty" text="Nothing"/>
                <ui:Label name="summary-lost" class="screen-text screen-text--muted" text=""/>
                <ui:Label class="screen-section" text="Achievements"/>
                <ui:ScrollView name="summary-achievements" class="item-list summary-achievements"/>
                <ui:Label name="summary-achievements-empty" class="screen-empty" text="None this run"/>
                <ui:Button name="btn-to-hub" class="screen-btn screen-btn--primary" text="To the Camp"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Поверх экранов: панель достижений, окно «Unlocked: X», тосты достижений, подсказки туториала (в этом порядке по глубине).
             Контроллеры (AchievementsPanel, UnlockPopup, AchievementToasts) создаёт CodeEditorManager -->
        <ui:Instance template="AchievementsPanel" name="achievements-overlay" class="screen-overlay" picking-mode="Ignore"/>
        <ui:Instance template="UnlockPopup" name="unlock-overlay" class="screen-overlay" picking-mode="Ignore"/>
        <ui:Instance template="AchievementToast" name="toast-overlay" class="screen-overlay" picking-mode="Ignore"/>
        <!-- Подсказки туториала — выше всего, но мышь ловит только карточка (TutorialOverlay) -->
        <ui:Instance template="TutorialOverlay" name="tutorial-overlay" class="screen-overlay" picking-mode="Ignore"/>

    </ui:VisualElement>
</ui:UXML>
