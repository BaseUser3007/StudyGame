.window {
    position: absolute;
    min-width: 300px;
    min-height: 200px;
    width: 400px;
    height: 500px;
    flex-direction: column;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(60, 60, 60);
    background-color: rgb(25, 25, 25);
}

.window-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    height: 32px;
    background-color: rgb(40, 40, 40);
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.window-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
    flex-grow: 1;
}

.title-edit {
    flex-grow: 1;
    border-width: 1px;
    border-radius: 3px;
    padding: 0 4px;
    font-size: 13px;
    -unity-font-style: bold;
    height: 22px;
}

.title-edit-invalid {
    border-color: rgb(200, 60, 60);
    border-width: 1px;
}

.title-edit > .unity-text-field__input {
    padding: 0 4px;
    font-size: 13px;
    -unity-font-style: bold;
}

.hidden {
    display: none;
}

.btn-close {
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: 3px;
    background-color: rgb(80, 50, 50);
    color: rgb(220, 150, 150);
    border-width: 0;
    font-size: 12px;
}

.btn-close:hover {
    background-color: rgb(120, 60, 60);
}

.code-area {
    flex-grow: 1;
    flex-direction: row;
    overflow: hidden;
    min-height: 0;
}

.line-numbers {
    width: 36px;
    min-width: 36px;
    max-width: 36px;
    padding: 4px;
    -unity-text-align: upper-right;
    font-size: 13px;
    color: rgb(100, 100, 100);
    white-space: pre;
    background-color: rgb(30, 30, 30);
    border-right-width: 1px;
    border-right-color: rgb(60, 60, 60);
    overflow: hidden;
}

.code-wrapper {
    flex-grow: 1;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    width: 0;
}

.code-field {
    flex-grow: 1;
    border-width: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0,0,0,0);
}

.code-field:focus {
    border-width: 0;
}

.code-field:hover {
    border-width: 0;
}

.code-field > .unity-text-field__input {
    flex-grow: 1;
    height: 100%;
    white-space: pre;
    overflow: scroll;
    padding: 4px;
    margin: 0;
    border-width: 0;
    font-size: 13px;
    color: rgb(220, 220, 220);
    background-color: rgb(30, 30, 30);
    min-width: 0;
    min-height: 0;
    -unity-overflow-clip-box: content-box;
}

.resize-handle {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 16px;
    height: 16px;
    background-color: rgb(60, 60, 60);
    border-top-left-radius: 3px;
}

.resize-handle:hover {
    background-color: rgb(100, 100, 100);
}