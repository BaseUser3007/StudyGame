/* Лог главного окна: итог запуска, уведомления и ошибки с объяснением (RunLog.cs) */

.run-log {
    flex-shrink: 0;
    max-height: 40%;
    min-height: 0;
    flex-direction: column;
    border-top-width: 1px;
    border-top-color: rgb(80, 120, 80);
    background-color: rgb(22, 22, 22);
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.run-log-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 20px;
    padding: 0 4px 0 8px;
    background-color: rgb(35, 45, 35);
}

.run-log-title {
    flex-grow: 1;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(150, 190, 150);
    padding: 0;
    margin: 0;
}

.run-log-clear {
    width: 18px;
    height: 16px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 3px;
    font-size: 12px;
    color: rgb(200, 200, 200);
    background-color: rgb(55, 55, 55);
}

.run-log-clear:hover {
    background-color: rgb(90, 60, 60);
}

.run-log-entries {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* Справа — место под ручку изменения размера окна */
.run-log-entries > .unity-scroll-view__content-viewport {
    margin-right: 6px;
}

.run-log-entry {
    flex-direction: column;
    padding: 3px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 40, 40);
}

.run-log-entry--error {
    border-left-width: 3px;
    border-left-color: rgb(200, 70, 70);
    padding-left: 5px;
}

.run-log-entry Label {
    margin: 0;
    padding: 0;
    font-size: 12px;
    white-space: normal;
}

.run-log-message {
    color: rgb(200, 200, 200);
}

.run-log-entry > .run-log-location {
    margin-top: 2px;
    -unity-font-style: bold;
    color: rgb(230, 200, 110);
}

.run-log-entry > .run-log-explanation {
    margin-top: 2px;
    color: rgb(215, 215, 215);
}

.run-log-entry > .run-log-suggestion {
    margin-top: 2px;
    color: rgb(150, 210, 150);
}
